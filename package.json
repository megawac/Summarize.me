{
  "name": "summarize-github",
  "description": "A JSON templated resume with a summary of Github activity",
  "authors": [
    {
      "name": "Graeme Yeates",
      "link": "github.com/megawac"
    }
  ],
  "version": "0.2.1",
  "keywords": [
    "resume",
    "github"
  ],
  "type": "module",
  "devDependencies": {
    "@parcel/config-default": "^2.12.0",
    "@parcel/transformer-less": "^2.12.0",
    "@parcel/transformer-raw": "^2.12.0",
    "@parcel/transformer-typescript-tsc": "^2.12.0",
    "@types/jquery": "^3.5.18",
    "@types/knockout": "^3.4.71",
    "parcel": "^2.12.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "dev": "parcel index.html --port 9000 --host 0.0.0.0 --open false",
    "build": "parcel build index.html --dist-dir dist --public-url ./",
    "watch": "parcel index.html --port 9000 --host 0.0.0.0 --open false",
    "clean": "rm -rf dist .parcel-cache",
    "preview": "parcel serve dist/index.html --port 8080"
  },
  "engines": {
    "node": ">=0.8.0"
  }
}
