{
    "node": true,
    "browser": true,
    "esversion": 11,
    "bitwise": true,
    "camelcase": false,
    "curly": false,
    "eqeqeq": true,
    "immed": true,
    "latedef": true,
    "newcap": true,
    "noarg": true,
    "quotmark": false,
    "regexp": true,
    "undef": true,
    "unused": true,
    "strict": true,
    "loopfunc": true,
    "trailing": true,
    "smarttabs": false,

    "globals": {
        "jQuery": true,
        "$": true,
        "Q": true,
        "Hogan": true,
        "fallback": true,
        "_": true,
        "ko": true,
        "resume": true,
        "JSON": true,
        "Promise": true,
        "Map": true,
        "Set": true
    }
}
